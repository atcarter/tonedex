# Maintainer-only notes (backlog, runbooks) are kept privately, outside the repo
BACKLOG.md
docs/runbooks/

# Environment files — never commit secrets
.env
.env.local
.env.*.local
.env.production
.env.development

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Backend (Rails)
backend/log/*
backend/tmp/*
backend/storage/*
backend/.bundle
backend/vendor/bundle
!backend/log/.keep
!backend/tmp/.keep
!backend/storage/.keep

# Rails secrets — must never be committed; production reads secrets from env vars
backend/config/master.key
backend/config/credentials.yml.enc
backend/config/credentials/

# Frontend (Node)
frontend/node_modules/
frontend/dist/
frontend/.cache/

# Docker
.docker/

# Coverage
coverage/

# Playwright output (any directory — a wrong-cwd run once left one at the root)
test-results/
playwright-report/

# In-flight sprite downloads (SpriteStore writes .tmp then renames)
backend/public/sprites/**/*.tmp
