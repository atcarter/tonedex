# Copy to terraform.tfvars (gitignored) and replace every CHANGEME.
# Provider credentials are NOT set here: export RENDER_API_KEY and
# RENDER_OWNER_ID in your shell instead.

github_repo_url       = "CHANGEME"
secret_key_base       = "CHANGEME"
jwt_secret            = "CHANGEME"
google_client_id      = "CHANGEME"
google_client_secret  = "CHANGEME"
sidekiq_allowed_email = "CHANGEME"

# Optional; the defaults are shown.
# region          = "oregon"
# github_branch   = "main"
# keyvalue_plan   = "free"
# sentry_dsn      = ""
# vite_sentry_dsn = ""

# Empty (the default) keeps Postgres private. Add your IP only for an apply
# that needs an external connection, then remove it and apply again.
# postgres_ip_allow_list = [
#   { cidr_block = "203.0.113.7/32", description = "one-off psql session" },
# ]
