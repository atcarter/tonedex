# Copy to .env.local and fill in real values. All services (backend, sidekiq,
# frontend) load this single root-level file via Docker Compose / Vite envDir.
# Never commit .env.local — it is gitignored.

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Frontend sign-in button (Vite exposes VITE_* to the browser)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Backend: ID token verification (SPA flow) + OmniAuth (Sidekiq admin flow)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ── API auth ─────────────────────────────────────────────────────────────────
# Signs/verifies the 30-day JWTs issued to SPA users. Generate with:
#   openssl rand -hex 64
JWT_SECRET=change-me

# ── Sidekiq Web UI ───────────────────────────────────────────────────────────
# Only this Google account can access /sidekiq
SIDEKIQ_ALLOWED_EMAIL=you@example.com

# ── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3000
# Optional: Sentry error tracking (frontend). Leave empty to disable.
VITE_SENTRY_DSN=

# ── Backend infrastructure ───────────────────────────────────────────────────
# Docker Compose overrides these with service-name hosts; set them here for
# non-Docker use (backend/Procfile.dev).
POSTGRES_HOST=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
REDIS_URL=redis://localhost:6379

# Optional: Sentry error tracking (backend). Leave empty to disable.
SENTRY_DSN=

# ── Production only ──────────────────────────────────────────────────────────
# Leave these commented out in development. On Render, Terraform sets them
# (infra/render): HTTP_PORT on tonedex-api, the rest in the tonedex-backend
# env group shared by the api and worker.
#
# Rails secret for signing and encryption. Generate with: bin/rails secret
# SECRET_KEY_BASE=change-me
# The production database. Rails reads only this; development and test use
# the POSTGRES_* values above, and setting it locally would override them.
# DATABASE_URL=postgres://user:password@host:5432/pokedex_production
# Comma-separated allowed CORS origins; production refuses to boot without it
# (development defaults to http://localhost:5173)
# CORS_ORIGINS=https://example.com,https://www.example.com
# Comma-separated allowed Host headers, also OmniAuth's callback hosts; unset disables both
# ALLOWED_HOSTS=example.com,www.example.com
# Port Thruster listens on (it starts Puma behind it). Set this, not PORT.
# HTTP_PORT=10000
